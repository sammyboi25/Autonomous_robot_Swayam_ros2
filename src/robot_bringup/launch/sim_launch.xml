<launch>
  <let name="my_robot_desc_dir" value="$(find-pkg-share robot_des)"/>
  <let name="world_path" value="$(find-pkg-share robot_bringup)/worlds/home.sdf"/>
  
  <let name="gazebo_config_path" value="$(find-pkg-share robot_bringup)/config/gazebo_bridge.yaml"/>

  <!-- Added Nav2 Asset Paths -->
  <let name="map_yaml_path" value="$(find-pkg-share robot_bringup)/maps/my_map.yaml"/>
  <let name="nav2_params_path" value="$(find-pkg-share robot_bringup)/config/nav2_params.yaml"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var my_robot_desc_dir)/urdf/robot.urdf.xacro')"/>
  </node>

  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-r $(var world_path)"/>
  </include>

  <!-- ========================================================= -->
  <!-- FIX: Delay the robot spawner by 5 seconds                 -->
  <!-- ========================================================= -->
  <timer period="5.0">
    <node pkg="ros_gz_sim" exec="create"
          args="-topic /robot_description -name my_robot -z 0.0">
    </node>
  </timer>

  <node pkg="ros_gz_bridge" exec="parameter_bridge">
    <param name="config_file" value="$(var gazebo_config_path)"/>
  </node>

  <node pkg="rviz2" exec="rviz2"/>
</launch>