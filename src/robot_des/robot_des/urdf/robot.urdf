<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro"> 

    <material name="red"><color rgba="1 0 0 1"/></material>
    <material name="blue"><color rgba="0 0 1 1"/></material>
    <material name="black"><color rgba="0 0 0 1"/></material>

    #all links are defined here

    <link name="base_link"> 
        <visual>
            <geometry><box size="0.5 0.5 0.5"/></geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
        <inertial>
            <mass value="1.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0417" ixy="0.0" ixz="0.0" iyy="0.0417" iyz="0.0" izz="0.0417"/>
        </inertial>
        <collision>
            <geometry><box size="0.5 0.5 0.5"/></geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>

    <link name="right_wheel">
        <visual>
            <geometry><cylinder radius="0.1" length="0.05"/></geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <material name="black"/>
        </visual>
        <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <inertia ixx="0.001355" ixy="0.0" ixz="0.0" iyy="0.001355" iyz="0.0" izz="0.001355"/>
        </inertial>
        <collision>
            <geometry><sphere radius="0.1"/></geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        </collision>
    </link>

    <link name="left_wheel">
        <visual>
            <geometry><cylinder radius="0.1" length="0.05"/></geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <material name="black"/>
        </visual>
        <inertial>
            <mass value="0.5"/>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <inertia ixx="0.001355" ixy="0.0" ixz="0.0" iyy="0.001355" iyz="0.0" izz="0.001355"/>
        </inertial>
        <collision>
            <geometry><sphere radius="0.1"/></geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        </collision>
    </link>

    <link name="caster_wheel">
        <visual>
            <geometry><sphere radius="0.05"/></geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
        <inertial>
            <mass value="0.2"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
        </inertial>
        <collision>
            <geometry><sphere radius="0.05"/></geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>


    <link name="lidar_link">
        <visual>
            <geometry><cylinder radius="0.05" length="0.05"/></geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00008" ixy="0.0" ixz="0.0" iyy="0.00008" iyz="0.0" izz="0.00008"/>
        </inertial>
        <collision>
            <geometry><cylinder radius="0.05" length="0.05"/></geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>

    <link name="camera_link">
        <visual>
            <geometry><box size="0.05 0.05 0.05"/></geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.000004" ixy="0.0" ixz="0.0" iyy="0.000004" iyz="0.0" izz="0.000004"/>
        </inertial>
        <collision>
            <geometry><box size="0.05 0.05 0.05"/></geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>

    #all joints are defined here

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="-0.275 -0.25 -0.25" rpy="1.57 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="-0.275 0.25 -0.25" rpy="1.57 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="0.15 0 -0.30" rpy="0 0 0"/>
    </joint>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.275" rpy="0 0 0"/>
    </joint>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.275 0 0" rpy="0 1.57 0"/>
    </joint>
</robot>
